<div id="search-overlay" class="search-overlay" data-search-url="<%- url_for('search.json') %>" role="dialog" aria-modal="true" aria-hidden="true" aria-label="<%= __('search') %>">
  <div class="search-modal" role="document">
    <div class="search-header">
      <input type="text" id="search-input" class="search-input" placeholder="<%= __('search') %>..." autocomplete="off">
      <button id="search-close" class="search-close" type="button" aria-label="关闭搜索">&times;</button>
    </div>
    <div id="search-results" class="search-results" data-placeholder="<%= __('search') %>">
      <div class="search-hint"><%= __('search') %></div>
    </div>
  </div>
</div>
