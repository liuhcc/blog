.search-overlay
  display: none
  position: fixed
  top: 0
  left: 0
  width: 100%
  height: 100%
  background: rgba(0, 0, 0, 0.5)
  z-index: 9999
  justify-content: center
  align-items: flex-start
  padding-top: 15vh
  &.active
    display: flex

.search-modal
  background: #fff
  width: 90%
  max-width: 600px
  border-radius: 6px
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25)
  overflow: hidden

.search-header
  display: flex
  align-items: center
  border-bottom: 1px solid color-border
  padding: 10px 15px

.search-input
  flex: 1
  border: none
  outline: none
  font-size: 16px
  padding: 8px 0
  background: transparent
  color: color-default

.search-close
  font-size: 24px
  color: color-grey
  cursor: pointer
  padding: 0 5px
  &:hover
    color: color-default

.search-results
  max-height: 50vh
  overflow-y: auto
  padding: 10px 0

.search-hint
  padding: 20px
  text-align: center
  color: color-grey
  font-size: 0.9em

.search-result-item
  display: block
  padding: 12px 20px
  color: color-default
  text-decoration: none
  border-bottom: 1px solid color-background
  transition: background 0.15s
  &:hover, &.active
    background: color-background
    color: color-link
  .search-result-title
    font-size: 15px
    margin-bottom: 3px
  .search-result-meta
    font-size: 12px
    color: color-grey
    display: flex
    gap: 10px

.search-no-results
  padding: 20px
  text-align: center
  color: color-grey

.search-highlight
  color: color-link
  font-weight: bold
