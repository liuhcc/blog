body.dark-mode
  background: #1a1a2e
  color: #ccc

  #wrap
    background: #1a1a2e

  #banner
    background: #0d1117

  #header
    background: #161b22
    border-bottom: 1px solid #30363d

  #footer
    background: #0d1117
    color: #8b949e
    a
      color: #58a6ff

  #logo, #subtitle
    color: #e6e6e6

  .main-nav-link, .nav-icon
    color: #8b949e
    &:hover
      color: #e6e6e6

  .article
    .article-inner
      background: #161b22
      border: 1px solid #30363d
      box-shadow: none

    .article-title
      color: #e6e6e6

    .article-entry
      color: #c9d1d9
      a
        color: #58a6ff

    .article-date a
      color: #8b949e

    .article-more-link a
      background: #21262d
      color: #8b949e
      text-shadow: none

    .article-footer
      border-top-color: #30363d
      a
        color: #8b949e

    .article-tag-list-link
      color: #8b949e
      &:before
        color: #8b949e

    blockquote
      border-left-color: #58a6ff
      background: #21262d
      color: #b1b1b1

    code
      background: #30363d
      color: #e6e6e6

    pre
      background: #0d1117
      border: 1px solid #30363d

    table
      th
        border-bottom-color: #30363d
      td
        border-bottom-color: #21262d

  .category-list-link, .tag-list-link, .archive-list-link, .recent-post-link
    color: #8b949e
    &:hover
      color: #e6e6e6

  #sidebar
    background: #161b22
    border-color: #30363d

  .widget
    background: #161b22
    border: 1px solid #30363d
    box-shadow: none

  #back-to-top
    background: #58a6ff
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3)

  #reading-progress-bar
    background: #58a6ff

  #search-overlay
    background: rgba(0, 0, 0, 0.85)

  .search-result-item
    background: #161b22
    border-color: #30363d
    &:hover, &.active
      background: #21262d

  #search-input
    background: #21262d
    color: #e6e6e6
    border-color: #30363d

  .nav-dark-mode-btn
    cursor: pointer
    &:hover
      color: #f0c040

  .article-reading-time
    color: #8b949e

  .page-nav
    a, span
      color: #8b949e
      background: #21262d
      border-color: #30363d

  .article-share-box
    background: #161b22
    box-shadow: 1px 2px 10px rgba(0, 0, 0, 0.5)

  .article-share-input
    color: #e6e6e6
    border-color: #30363d

  .article-share-links
    background: #21262d

  #mobile-nav
    background: #0d1117

  .mobile-nav-link
    color: #8b949e

  .toc-wrap
    background: #161b22
    border-color: #30363d

  .toc-header:hover
    background: #21262d

  .toc-title
    color: #e6e6e6

  .toc-link
    color: #8b949e
    &:hover
      color: #58a6ff

  .toc-level-1 .toc-link
    color: #e6e6e6

  .article-toggle-btn
    color: #8b949e
    border-color: #30363d
    &:hover
      color: #58a6ff
      border-color: #58a6ff

  .search-modal
    background: #161b22

  .search-header
    border-bottom-color: #30363d