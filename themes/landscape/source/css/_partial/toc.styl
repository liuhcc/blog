.toc-wrap
  background: #fafafa
  border: 1px solid color-border
  border-radius: 6px
  margin-bottom: 20px
  overflow: hidden

.toc-header
  display: flex
  justify-content: space-between
  align-items: center
  padding: 12px 16px
  cursor: pointer
  user-select: none
  &:hover
    background: #f0f0f0

.toc-title
  font-weight: bold
  font-size: 15px
  color: color-default
  .fa
    margin-right: 6px
    color: color-link

.toc-toggle
  color: color-grey
  font-size: 12px
  transition: transform 0.3s
  .toc-wrap.collapsed &
    transform: rotate(180deg)

.toc-body
  padding: 0 16px 12px
  .toc-wrap.collapsed &
    display: none

.toc-list
  list-style: none
  margin: 0
  padding: 0

.toc-item
  line-height: 1.8

.toc-level-1
  font-weight: bold
  .toc-link
    color: color-default

.toc-level-2
  padding-left: 16px

.toc-level-3
  padding-left: 32px

.toc-link
  color: color-default
  text-decoration: none
  font-size: 14px
  display: block
  padding: 2px 0
  border-bottom: 1px solid transparent
  &:hover
    color: color-link
