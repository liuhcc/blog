// Home page welcome section
.home-welcome
  background: linear-gradient(135deg, #258fb8 0%, #1a6d8a 100%)
  color: #fff
  padding: 50px 30px
  margin-bottom: 30px
  border-radius: 12px
  text-align: center
  box-shadow: 0 4px 20px rgba(37, 143, 184, 0.25)

.home-welcome-inner
  max-width: 600px
  margin: 0 auto

.home-welcome-title
  font-size: 2.2em
  font-weight: 700
  margin: 0 0 12px
  color: #fff
  letter-spacing: 1px

.home-welcome-subtitle
  font-size: 1.15em
  margin: 0 0 8px
  opacity: 0.95
  font-weight: 400

.home-welcome-desc
  font-size: 0.95em
  margin: 0 0 20px
  opacity: 0.8
  font-weight: 300

.home-welcome-stats
  display: flex
  justify-content: center
  gap: 30px
  padding-top: 16px
  border-top: 1px solid rgba(255, 255, 255, 0.25)

.home-stat
  text-align: center
  font-size: 0.9em
  opacity: 0.85

.home-stat-num
  display: block
  font-size: 1.6em
  font-weight: 700
  opacity: 1
  line-height: 1.4

// Recent posts header
.home-posts-header
  margin-bottom: 20px
  padding-bottom: 12px
  border-bottom: 2px solid #258fb8

.home-posts-title
  font-size: 1.3em
  font-weight: 700
  color: #333
  margin: 0
  display: flex
  align-items: center
  &:before
    content: ''
    display: inline-block
    width: 4px
    height: 20px
    background: #258fb8
    border-radius: 2px
    margin-right: 10px

// Article excerpt on index
.article-excerpt
  color: #666
  line-height: 1.8
  margin-bottom: 0

// Index article more link
.article-more-link
  a
    display: inline-block
    color: #258fb8
    text-decoration: none
    font-size: 0.95em
    font-weight: 500
    padding: 6px 18px
    border: 1px solid #258fb8
    border-radius: 20px
    transition: all 0.25s ease
    &:hover
      background: #258fb8
      color: #fff

// Dark mode support
body.dark-mode
  .home-welcome
    background: linear-gradient(135deg, #1a3a4a 0%, #0d2130 100%)
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4)

  .home-posts-header
    border-bottom-color: #30363d

  .home-posts-title
    color: #e6e6e6
    &:before
      background: #58a6ff

  .article-excerpt
    color: #8b949e
